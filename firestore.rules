rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function requireAuth() {
      return request.auth != null;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentCustomerId() {
      return requireAuth() ? userProfile().data.customerId : null;
    }

    function isAdmin() {
      return requireAuth() && userProfile().data.roles.hasAny(["admin"]);
    }

    match /users/{userId} {
      allow read: if requireAuth() && request.auth.uid == userId;
      allow write: if isAdmin();
    }

    match /voice_logs/{logId} {
      allow read: if requireAuth() && resource.data.customerId == currentCustomerId();
      allow write: if false;
    }

    match /usage_counters/{customerId} {
      allow read: if requireAuth() && customerId == currentCustomerId();
      allow write: if false;
    }

    match /api_keys/{hash} {
      allow read: if requireAuth() && resource.data.customerId == currentCustomerId();
      allow create: if requireAuth() && request.resource.data.customerId == currentCustomerId();
      allow update: if requireAuth() && resource.data.customerId == currentCustomerId();
      allow delete: if isAdmin();
    }

    match /customers/{customerId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /webhook_events/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /billing/{docId} {
      allow read: if requireAuth() && resource.data.customerId == currentCustomerId();
      allow write: if false;
    }

    match /phone_history/{docId} {
      allow read: if false;
      allow write: if false;
    }
  }
}
