{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "lib",
    "rootDir": "src",
    "module": "CommonJS",
    "target": "ES2022",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "types": ["node"],
    "baseUrl": "./",
    "paths": {
      "@rivoct/shared": ["../shared/dist"],
      "@rivoct/shared/*": ["../shared/dist/*"]
    }
  },
  "include": ["src"],
  "exclude": ["src/**/__tests__", "src/**/*.test.ts", "node_modules"]
}
