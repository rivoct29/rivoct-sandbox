{
  "name": "rivoct-sandbox",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "functions",
    "webhook",
    "web",
    "shared"
  ],
  "scripts": {
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "clean": "rimraf functions/lib web/.next web/out .firebase",
    "clean:packages": "rimraf functions/lib web/.next web/out .firebase .tmp .pnpm-store .pnpm node_modules",
    "clean:full": "pnpm run clean && rimraf node_modules */node_modules",
    "test": "pnpm --filter @rivoct/functions test && pnpm --filter @rivoct/web test",
    "test:ui": "vitest --ui",
    "test:coverage": "pnpm --filter @rivoct/functions test --coverage && pnpm --filter @rivoct/web test --coverage",
    "test:ci": "pnpm --filter @rivoct/functions test --run && pnpm --filter @rivoct/web test --run",
    "deploy:functions": "pnpm --filter @rivoct/functions run build && firebase deploy --only functions",
    "deploy:web": "pnpm --filter @rivoct/web run build && firebase deploy --only hosting",
    "deploy:sandbox": "pnpm run build && firebase deploy --only hosting,functions",
    "deploy:production": "pnpm run build && firebase deploy --only hosting,functions -P production",
    "deploy": "pnpm run deploy:sandbox",
    "deploy:ci": "node ./scripts/deploy-ci.js",
    "reorg:docs": "bash ./tools/reorg-docs.sh",
    "dedupe:archive": "bash ./tools/dedupe-latest.sh",
    "dedupe:preview": "bash ./tools/dedupe-latest.sh --dry-run"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.12",
    "@vitest/ui": "^4.0.12",
    "typescript": "5.6.3",
    "vitest": "^4.0.12"
  }
}
